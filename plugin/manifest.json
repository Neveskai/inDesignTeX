{
  "manifestVersion": 5,
  "id": "com.neveskai.indesigntex",
  "name": "inDesignTeX",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "InDesign",
    "minVersion": "18.5"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "indesigntex.panel",
      "label": {
        "default": "inDesignTeX",
        "pt_BR": "inDesignTeX"
      },
      "minimumSize": {
        "width": 300,
        "height": 400
      },
      "preferredDockedSize": {
        "width": 350,
        "height": 500
      }
    },
    {
      "type": "command",
      "id": "indesigntex.insertEquation",
      "label": {
        "default": "Insert LaTeX Equation",
        "pt_BR": "Inserir Equação LaTeX"
      }
    }
  ],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon-24.png",
      "scale": [1, 2]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite"
  }
}
